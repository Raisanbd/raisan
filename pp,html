    <script>
        // --- State Management ---
        let allChannels = [];
        let categories = new Set();
        let savedChannels = JSON.parse(localStorage.getItem('jd_saved')) || [];
        let likedChannels = JSON.parse(localStorage.getItem('jd_liked')) || [];
        let appSettings = JSON.parse(localStorage.getItem('jd_settings')) || { darkMode: false, autoplay: true };
        let currentChannel = null;
        let hls = null;
        let lastTabBeforePlayer = 'home'; // To track back button history
        
        // Live Like System Variables
        let liveLikeInterval = null;
        let currentLiveLikes = 0;

        // --- Initialization ---
        document.addEventListener('DOMContentLoaded', () => {
            applySettings();
        });

        function startApp() {
            document.getElementById('welcome-screen').classList.add('opacity-0');
            setTimeout(() => {
                document.getElementById('welcome-screen').classList.add('hidden');
                document.getElementById('main-app').classList.remove('hidden');
                switchTab('home');
                fetchChannels();
            }, 500);
        }

        // --- Fetch & Parse M3U Logic ---
        async function fetchChannels() {
            document.getElementById('loading-indicator').classList.remove('hidden');
            const jioUrl = "https://raw.githubusercontent.com/Raisanbd/moive-rplex/refs/heads/main/Sports.m3u";
            
            const methods = [
                { name: 'CodeTabs', url: 'https://api.codetabs.com/v1/proxy?quest=' + encodeURIComponent(jioUrl) },
                { name: 'CORS Proxy.io', url: 'https://corsproxy.io/?' + encodeURIComponent(jioUrl) },
                { name: 'AllOrigins', url: 'https://api.allorigins.win/raw?url=' + encodeURIComponent(jioUrl) },
                { name: 'Direct', url: jioUrl }
            ];

            let m3uData = null;

            for (const method of methods) {
                try {
                    console.log(`Trying to fetch via ${method.name}...`);
                    const response = await fetch(method.url);
                    if (response.ok) {
                        m3uData = await response.text();
                        console.log(`Success with ${method.name}`);
                        break;
                    }
                } catch (e) {
                    console.log(`${method.name} failed.`);
                }
            }

            document.getElementById('loading-indicator').classList.add('hidden');

            if (m3uData) {
                parseM3U(m3uData);
                renderDrawer();
                renderHome();
                renderSaved();
            } else {
                showToast("Failed to load channels. Please check internet.");
            }
        }

        function parseM3U(data) {
            const lines = data.split('\n');
            let currentCh = {};
            allChannels = [];
            categories.clear();

            for (let i = 0; i < lines.length; i++) {
                let line = lines[i].trim();
                if (line.startsWith('#EXTINF:')) {
                    const logoMatch = line.match(/tvg-logo="(.*?)"/);
                    const groupMatch = line.match(/group-title="(.*?)"/);
                    const nameParts = line.split(',');
                    const name = nameParts.length > 1 ? nameParts[1].trim() : 'Unknown Channel';
                    
                    currentCh = {
                        id: 'ch_' + Math.random().toString(36).substr(2, 9),
                        name: name,
                        logo: logoMatch ? logoMatch[1] : '',
                        group: groupMatch ? groupMatch[1] : 'Others'
                    };
                    categories.add(currentCh.group);
                } else if (line.startsWith('http')) {
                    currentCh.url = line;
                    if(currentCh.name) allChannels.push(currentCh);
                    currentCh = {};
                }
            }
        }

        // --- UI Rendering ---
        function createChannelCard(ch) {
            const isSaved = savedChannels.some(s => s.url === ch.url);
            return `
                <div class="glass rounded-xl p-3 cursor-pointer hover:bg-white/10 transition group" onclick='playChannel(${JSON.stringify(ch).replace(/'/g, "&apos;")})'>
                    <div class="aspect-video bg-black/40 rounded-lg flex items-center justify-center mb-3 overflow-hidden relative">
                        <img src="${ch.logo}" onerror="this.src='data:image/svg+xml;utf8,<svg xmlns=\\'http://www.w3.org/2000/svg\\' width=\\'100\\' height=\\'100\\'><rect width=\\'100\\' height=\\'100\\' fill=\\'%23333\\'/><text x=\\'50\\' y=\\'55\\' font-family=\\'Arial\\' font-size=\\'20\\' fill=\\'white\\' text-anchor=\\'middle\\'>TV</text></svg>'" class="h-full object-contain p-2 group-hover:scale-110 transition duration-300">
                        ${isSaved ? '<i class="ph-fill ph-bookmark absolute top-2 right-2 text-blue-400"></i>' : ''}
                    </div>
                    <h3 class="font-semibold text-sm truncate">${ch.name}</h3>
                    <p class="text-xs text-gray-400 truncate">${ch.group}</p>
                </div>
            `;
        }

        function renderDrawer() {
            const list = document.getElementById('category-list');
            let html = `<div class="p-3 hover:bg-white/10 rounded cursor-pointer transition mb-1" onclick="filterCategory('All')">All Channels</div>`;
            Array.from(categories).sort().forEach(cat => {
                if(cat.trim() !== "") {
                    html += `<div class="p-3 hover:bg-white/10 rounded cursor-pointer transition mb-1" onclick="filterCategory('${cat}')">${cat}</div>`;
                }
            });
            list.innerHTML = html;
        }

        function renderHome() {
            // Get 10 random/popular channels
            const shuffled = [...allChannels].sort(() => 0.5 - Math.random());
            const popular = shuffled.slice(0, 10);
            document.getElementById('popular-channels').innerHTML = popular.map(createChannelCard).join('');
        }

        function renderSaved() {
            const container = document.getElementById('saved-channels');
            const noSaved = document.getElementById('no-saved');
            if (savedChannels.length === 0) {
                container.innerHTML = '';
                noSaved.classList.remove('hidden');
            } else {
                noSaved.classList.add('hidden');
                container.innerHTML = savedChannels.map(createChannelCard).join('');
            }
        }

        // --- Interactions ---
        function toggleDrawer() {
            const drawer = document.getElementById('drawer');
            const overlay = document.getElementById('drawer-overlay');
            if (drawer.classList.contains('-translate-x-full')) {
                drawer.classList.remove('-translate-x-full');
                overlay.classList.remove('hidden');
                setTimeout(() => overlay.classList.remove('opacity-0'), 10);
            } else {
                drawer.classList.add('-translate-x-full');
                overlay.classList.add('opacity-0');
                setTimeout(() => overlay.classList.add('hidden'), 300);
            }
        }

        function filterCategory(cat) {
            toggleDrawer();
            switchTab('category-view'); // Open the specific category page
            
            document.getElementById('category-page-title').innerText = `${cat} Channels`;
            const container = document.getElementById('category-page-channels');
            
            const filtered = cat === 'All' ? allChannels : allChannels.filter(c => c.group === cat);
            container.innerHTML = filtered.slice(0, 100).map(createChannelCard).join(''); // Limit for performance
        }

        function handleSearch(query) {
            query = query.toLowerCase();
            const results = allChannels.filter(c => c.name.toLowerCase().includes(query) || c.group.toLowerCase().includes(query)).slice(0, 40);
            document.getElementById('search-results').innerHTML = results.map(createChannelCard).join('');
        }

        function switchTab(tabId) {
            const mainHeader = document.getElementById('main-header');
            const mainContent = document.getElementById('content');

            // Save last tab if we are going to player so 'Back' works properly
            if (tabId === 'player') {
                const activeTab = document.querySelector('.tab-content:not(.hidden)');
                if (activeTab && activeTab.id !== 'tab-player') {
                    lastTabBeforePlayer = activeTab.id.replace('tab-', '');
                }
                // Hide header and remove main padding so player touches the edges
                mainHeader.classList.add('hidden');
                mainContent.classList.remove('p-4');
                mainContent.classList.add('pb-4'); // Keep bottom padding for nav
            } else {
                // Show header and restore padding
                mainHeader.classList.remove('hidden');
                mainContent.classList.add('p-4');
                mainContent.classList.remove('pb-4');
            }

            // Hide all tabs
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            
            // Remove active class from nav
            document.querySelectorAll('.nav-btn').forEach(el => {
                el.classList.remove('text-blue-400');
                el.classList.add('text-gray-400');
                let icon = el.querySelector('i');
                icon.classList.remove('ph-fill');
                icon.classList.add('ph');
            });

            // Show selected tab
            document.getElementById(`tab-${tabId}`).classList.remove('hidden');
            
            // Highlight nav if exists
            const btn = document.querySelector(`.nav-btn[data-tab="${tabId}"]`);
            if (btn) {
                btn.classList.remove('text-gray-400');
                btn.classList.add('text-blue-400');
                let icon = btn.querySelector('i');
                icon.classList.remove('ph');
                icon.classList.add('ph-fill');
            }

            // --- STOP VIDEO LOGIC ---
            // If leaving player tab, completely stop the video and destroy instance
            if (tabId !== 'player') {
                const video = document.getElementById('tv-player');
                if (hls) { 
                    hls.destroy(); 
                    hls = null; 
                }
                video.pause();
                video.removeAttribute('src'); // Completely unloads video
                video.load();
                
                // Stop fake live likes
                if(liveLikeInterval) clearInterval(liveLikeInterval);
            }

            if(tabId === 'save') renderSaved();
        }

        // --- Player Logic ---
        function playChannel(channel) {
            currentChannel = channel;
            switchTab('player');
            
            document.getElementById('player-title').innerText = channel.name;
            document.getElementById('player-category').innerText = channel.group;
            document.getElementById('player-logo').src = channel.logo;
            
            updatePlayerButtons();
            startLiveLikeCounter(); // Start live likes animation
            
            // Related channels
            const related = allChannels.filter(c => c.group === channel.group && c.url !== channel.url).slice(0, 10);
            document.getElementById('related-channels').innerHTML = related.map(createChannelCard).join('');

            const video = document.getElementById('tv-player');
            const errorMsg = document.getElementById('player-error');
            const errorText = document.getElementById('error-text');
            errorMsg.classList.add('hidden');
            
            if (hls) { hls.destroy(); }
            
            // Function to try playing stream, with optional CORS proxy fallback
            function loadStream(url, isProxy = false) {
                if (Hls.isSupported()) {
                    hls = new Hls();
                    hls.loadSource(url);
                    hls.attachMedia(video);
                    hls.on(Hls.Events.MANIFEST_PARSED, function () {
                        if(appSettings.autoplay) video.play();
                    });
                    hls.on(Hls.Events.ERROR, function (event, data) {
                        if (data.fatal) {
                            // --- CORS FIX LOGIC ---
                            if (!isProxy) {
                                console.log("Direct stream failed (possible CORS). Trying proxy...");
                                hls.destroy();
                                const proxyUrl = 'https://corsproxy.io/?' + encodeURIComponent(channel.url);
                                loadStream(proxyUrl, true);
                            } else {
                                // Both failed
                                errorMsg.classList.remove('hidden');
                                errorText.innerText = "Stream unavailable or blocked by CORS.";
                            }
                        }
                    });
                } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
                    video.src = url;
                    video.addEventListener('loadedmetadata', function () {
                        if(appSettings.autoplay) video.play();
                    });
                    video.addEventListener('error', function() {
                        if(!isProxy) {
                            const proxyUrl = 'https://corsproxy.io/?' + encodeURIComponent(channel.url);
                            loadStream(proxyUrl, true);
                        } else {
                            errorMsg.classList.remove('hidden');
                            errorText.innerText = "Stream unavailable or blocked by CORS.";
                        }
                    });
                }
            }

            loadStream(channel.url, false);
        }

        function closePlayer() {
            switchTab(lastTabBeforePlayer); // The switchTab function now handles video stopping entirely
        }

        // --- Live Like Counter Logic ---
        function startLiveLikeCounter() {
            if(liveLikeInterval) clearInterval(liveLikeInterval);
            
            // Generate a random starting number between 1200 and 5000
            currentLiveLikes = Math.floor(Math.random() * (5000 - 1200 + 1) + 1200);
            document.getElementById('live-like-count').innerText = currentLiveLikes.toLocaleString();
            
            liveLikeInterval = setInterval(() => {
                // 60% chance to increment likes every 2.5 seconds to feel natural
                if(Math.random() > 0.4) {
                    currentLiveLikes += Math.floor(Math.random() * 4) + 1; // Add 1 to 4 likes
                    document.getElementById('live-like-count').innerText = currentLiveLikes.toLocaleString();
                }
            }, 2500);
        }

        // --- Player Controls ---
        function updatePlayerButtons() {
            if(!currentChannel) return;
            const isSaved = savedChannels.some(s => s.url === currentChannel.url);
            const isLiked = likedChannels.some(s => s.url === currentChannel.url);
            
            const saveBtn = document.getElementById('btn-save');
            const likeBtn = document.getElementById('btn-like');

            saveBtn.innerHTML = `<i class="${isSaved ? 'ph-fill text-blue-500' : 'ph text-gray-400'} ph-bookmark text-2xl group-active:scale-75 transition-transform"></i><span class="text-xs">Save${isSaved?'d':''}</span>`;
            likeBtn.innerHTML = `<i class="${isLiked ? 'ph-fill text-pink-500' : 'ph text-gray-400'} ph-heart text-2xl group-active:scale-75 transition-transform"></i><span class="text-xs">Like${isLiked?'d':''}</span>`;
        }

        function toggleSaveCurrent() {
            if(!currentChannel) return;
            const index = savedChannels.findIndex(s => s.url === currentChannel.url);
            if(index > -1) {
                savedChannels.splice(index, 1);
                showToast("Removed from Saved");
            } else {
                savedChannels.push(currentChannel);
                showToast("Added to Saved");
            }
            localStorage.setItem('jd_saved', JSON.stringify(savedChannels));
            updatePlayerButtons();
            renderSaved(); 
        }

        function toggleLikeCurrent() {
            if(!currentChannel) return;
            const index = likedChannels.findIndex(s => s.url === currentChannel.url);
            if(index > -1) {
                likedChannels.splice(index, 1);
            } else {
                likedChannels.push(currentChannel);
                // Immediately add +1 to live counter when user clicks like
                currentLiveLikes += 1;
                document.getElementById('live-like-count').innerText = currentLiveLikes.toLocaleString();
            }
            localStorage.setItem('jd_liked', JSON.stringify(likedChannels));
            updatePlayerButtons();
        }

        // Fixed Full Screen logic for better device compatibility
        function toggleFullScreen() {
            const video = document.getElementById('tv-player');
            if (!document.fullscreenElement && !document.webkitFullscreenElement && !document.msFullscreenElement) {
                if (video.requestFullscreen) {
                    video.requestFullscreen();
                } else if (video.webkitRequestFullscreen) { /* Safari */
                    video.webkitRequestFullscreen();
                } else if (video.msRequestFullscreen) { /* IE11 */
                    video.msRequestFullscreen();
                }
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen();
                } else if (document.webkitExitFullscreen) { /* Safari */
                    document.webkitExitFullscreen();
                } else if (document.msExitFullscreen) { /* IE11 */
                    document.msExitFullscreen();
                }
            }
        }

        // Fixed Mini Screen (PiP) logic
        async function toggleMiniScreen() {
            const video = document.getElementById('tv-player');
            try {
                if (document.pictureInPictureElement) {
                    await document.exitPictureInPicture();
                } else if (document.pictureInPictureEnabled && !video.disablePictureInPicture) {
                    await video.requestPictureInPicture();
                } else {
                    showToast("Mini screen (PiP) is not supported on this browser/device.");
                }
            } catch (error) {
                console.error(error);
                showToast("Failed to open Mini Screen.");
            }
        }

        // --- Settings Logic ---
        function toggleSetting(key, val) {
            appSettings[key] = val;
            localStorage.setItem('jd_settings', JSON.stringify(appSettings));
            applySettings();
        }

        function applySettings() {
            document.getElementById('setting-darkmode').checked = appSettings.darkMode;
            document.getElementById('setting-autoplay').checked = appSettings.autoplay;
            
            if(appSettings.darkMode) {
                document.body.classList.add('dark-mode');
            } else {
                document.body.classList.remove('dark-mode');
            }
        }

        function clearCache() {
            localStorage.removeItem('jd_saved');
            localStorage.removeItem('jd_liked');
            savedChannels = [];
            likedChannels = [];
            showToast("Cache Cleared. Storage freed.");
            renderSaved();
        }

        function exportFavorites() {
            if(savedChannels.length === 0) {
                showToast("No favorites to export.");
                return;
            }
            let m3uContent = "#EXTM3U\n";
            savedChannels.forEach(ch => {
                m3uContent += `#EXTINF:-1 tvg-logo="${ch.logo}" group-title="${ch.group}",${ch.name}\n${ch.url}\n`;
            });
            const blob = new Blob([m3uContent], {type: "text/plain;charset=utf-8"});
            const url = URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.href = url;
            a.download = "JDLivetv_Favorites.m3u";
            a.click();
            URL.revokeObjectURL(url);
            showToast("Favorites exported successfully!");
        }

        // --- Utils ---
        function showToast(msg) {
            const toast = document.getElementById('toast');
            toast.innerText = msg;
            toast.classList.remove('opacity-0', 'translate-y-[-20px]');
            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-[-20px]');
            }, 3000);
        }

    </script>
</body>
</html>
