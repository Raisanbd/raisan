<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>FiFa World Cup</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <!-- HLS.js for IPTV Streams -->
    <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
    
    <style>
        /* Custom Styles & Animations */
        :root {
            --bg-glass: rgba(15, 23, 42, 0.7);
            --bg-glass-heavy: rgba(15, 23, 42, 0.9);
            --primary: #f22711;
            --ps-blue: #f21d0a;
            --ps-neon: #1e7805;
        }

        body {
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #e6eef0;
            color: #fff;
            overflow-x: hidden;
            -webkit-tap-highlight-color: transparent;
        }

        /* Background Images */
        #welcome-screen {
            background-image: url('https://w0.peakpx.com/wallpaper/183/933/HD-wallpaper-fifa-world-cup-26-u-sports-soccer-mexico-canada-football-fifa-world-cup-world-cup-2026-we-are-26-sport-event-international-competition-global-event-tournament.jpg');
            background-size: cover;
            background-position: center;
        }

        #main-app {
            background-image: url('https://wallpapercave.com/wp/wp15655961.jpg');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
        }

        /* PlayStation Button Animation */
        .ps-button {
            position: relative;
            background: linear-gradient(135deg, var(--ps-blue), #000000);
            border: 2px solid var(--ps-neon);
            box-shadow: 0 0 15px var(--ps-blue), inset 0 0 20px var(--ps-blue);
            overflow: hidden;
            transition: all 0.3s ease;
            text-shadow: 0 0 5px #fff;
        }

        .ps-button::before {
            content: '△ ○ ✕ □';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 1.5rem;
            color: rgba(255, 255, 255, 0.1);
            letter-spacing: 15px;
            white-space: nowrap;
            z-index: 0;
            animation: pulse-shapes 3s infinite alternate;
        }

        .ps-button span {
            position: relative;
            z-index: 1;
        }

        .ps-button:active {
            transform: scale(0.95);
            box-shadow: 0 0 30px var(--ps-neon), inset 0 0 30px var(--ps-neon);
        }

        @keyframes pulse-shapes {
            0% { opacity: 0.1; transform: translate(-50%, -50%) scale(1); filter: drop-shadow(0 0 2px var(--ps-neon)); }
            100% { opacity: 0.3; transform: translate(-50%, -50%) scale(1.1); filter: drop-shadow(0 0 8px var(--ps-neon)); }
        }

        /* Glassmorphism Classes */
        .glass {
            background: var(--bg-glass);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .glass-heavy {
            background: var(--bg-glass-heavy);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
        }

        /* Hide scrollbar */
        ::-webkit-scrollbar { width: 0px; height: 0px; }
        
        /* Drawer Transition */
        #drawer { transition: transform 0.3s ease-in-out; }
        
        /* Loading Spinner */
        .loader {
            border: 4px solid rgba(255,255,255,0.1);
            border-left-color: var(--primary);
            border-radius: 50%;
            width: 40px;
            height: 40px;
            animation: spin 1s linear infinite;
        }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

        /* Video Player Aspect Ratio */
        .video-container {
            position: relative;
            width: 100%;
            padding-top: 56.25%; /* 16:9 */
            background: #000;
        }
        .video-container video {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
        }

        /* Dark Mode Toggle classes */
        body.dark-mode::after {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.6);
            pointer-events: none;
            z-index: -1;
        }
    </style>
</head>
<body>

